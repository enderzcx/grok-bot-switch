{
  "schemaVersion": 1,
  "id": "custom-openai",
  "displayName": "Custom OpenAI",
  "protocol": "openai-chat",
  "baseUrl": "https://api.example.com/v1",
  "endpointPath": "/chat/completions",
  "model": "model-name",
  "auth": {
    "type": "bearer",
    "secretRef": "profile/custom-openai"
  },
  "headers": {},
  "parameters": {
    "reasoningEffort": "high",
    "maxTokens": 8192
  },
  "fallbackPolicy": "never",
  "enabled": true
}
